[
  {
    "name": "submit",
    "description": "Persist a recoverable task; return immediately.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "analysis",
            "coding",
            "review",
            "testing",
            "documentation"
          ]
        },
        "task": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "allow_cloud": {
          "type": "boolean"
        },
        "confidentiality": {
          "enum": [
            "local",
            "cloud-approved"
          ]
        },
        "reasoning": {
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "max",
            "ultra"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "tools",
              "json",
              "vision"
            ]
          }
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "number"
        },
        "idempotency_key": {
          "type": "string"
        },
        "quality": {
          "type": "object"
        }
      },
      "required": [
        "profile",
        "task"
      ],
      "additionalProperties": false
    }
  },
